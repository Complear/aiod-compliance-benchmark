{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/complear/aiod-compliance-benchmark/schema/scorecard.schema.json",
  "title": "AI evaluation scorecard",
  "description": "One evaluation run of one AI system on one benchmark, with the EU AI Act provisions each result is evidence for. Version 0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "benchmark", "run", "metrics"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "model", "provider"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string"},
        "provider": {"type": "string", "minLength": 1}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "dataset_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "split": {"type": "string"},
        "scope_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "environment"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "environment": {"enum": ["aiod-ai-runner", "local"]},
        "reference": {"type": "string"}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "higher_is_better", "ai_act_refs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "n": {"type": "integer", "minimum": 1},
          "higher_is_better": {"type": "boolean"},
          "ai_act_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "string"}
  }
}
